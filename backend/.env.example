# backend/.env 로 복사해서 값을 채운다. .env는 git에 올리지 않는다.
# Supabase 대시보드 → Project Settings → API Keys 에서 새 키(sb_publishable_…, sb_secret_…)를 쓴다.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SECRET_KEY=sb_secret_xxx

# 로컬: docker compose up -d 로 띄운 Redis 호환 저장소 / 배포: Render Key Value 내부 주소
REDIS_URL=redis://localhost:6379/0

# Google AI Studio에서 발급
GEMINI_API_KEY=

# 기본값을 바꿀 때만 적는다
# GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_THINKING_LEVEL=minimal
# GEMINI_TIMEOUT_SEC=30
# GEMINI_MIN_INTERVAL_SEC=4
# ACTIVE_PROMPT_VERSION=v2
# SIGNED_URL_TTL_SEC=600
# MAX_PHOTO_MB=10
# DRAFT_TTL_SEC=86400
# CACHE_TTL_SEC=604800
